# Vite only exposes env vars prefixed with VITE_ to client-side code — they
# get baked into the JS bundle at build time, so never put secrets here;
# anything here is publicly visible in the browser.

# Base URL of the backend API (no trailing slash).
#
# Local dev: leave unset — src/api/index.js falls back to
# http://localhost:3001 automatically.
#
# Production: set this to your deployed backend's public URL, e.g.
# https://api.yourdomain.com
VITE_API_URL=
